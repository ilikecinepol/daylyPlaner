APP_ENV=development
HOST=0.0.0.0
PORT=8000
RELOAD=1
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./planner.db
COOKIE_SECURE=0
ALLOWED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/google/callback

# One-time account unlock code for optional modules (AI, finance and CRACE).
# Keep it server-side. You can rotate it without revoking access already granted.
MODULE_ACCESS_CODE=
# Optional module-specific codes override/augment the shared code.
MODULE_ACCESS_CODE_AI=
MODULE_ACCESS_CODE_FINANCE=
MODULE_ACCESS_CODE_CRACE=

# Optional AI module. Demo makes no network requests and is not an LLM.
AI_ENABLED=0
AI_PROVIDER=demo
AI_DEMO_ACCESS=0
# Development only: grant AI access to local accounts when no explicit ai_access row exists.
AI_LOCAL_ACCESS=0
AI_USER_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=100
# Set explicitly for real responses; never expose this key in frontend code.
OPENAI_API_KEY=
AI_MODEL=
# To use DeepSeek: AI_PROVIDER=deepseek. No fallback to OPENAI_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
